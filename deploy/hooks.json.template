[
  {
    "id": "deploy",
    "execute-command": "/opt/robotikk-site/deploy/deploy.sh",
    "command-working-directory": "/opt/robotikk-site",
    "response-message": "Deploy triggered",
    "trigger-rule": {
      "match": {
        "type": "payload-hmac-sha256",
        "secret": "__WEBHOOK_SECRET__",
        "parameter": {
          "source": "header",
          "name": "X-Hub-Signature-256"
        }
      }
    }
  }
]
